# Dashboard web server
PORT=2022

# Discord OAuth2 application used by the dashboard
DASHBOARD_CLIENT_ID=your_discord_application_id
DASHBOARD_CLIENT_SECRET=your_discord_oauth_client_secret
DASHBOARD_REDIRECT_URI=https://your-domain.example/dashboard/callback
DASHBOARD_SESSION_SECRET=replace_with_a_long_random_secret
DASHBOARD_DEVELOPER_IDS=your_discord_user_id

# Dedicated Maker controller bot (kept separate from regular shop bots)
BOT_TOKEN_MAKER=your_maker_bot_token

# Optional general/main bot token
BOT_TOKEN_GENERAL=your_general_bot_token

# Other regular bot tokens, comma-separated
BOT_TOKENS=regular_bot_token_1,regular_bot_token_2

# 32-byte key encoded as 64 hexadecimal characters; keep stable to decrypt saved bot tokens
TOKEN_ENCRYPTION_KEY=replace_with_64_hex_characters
